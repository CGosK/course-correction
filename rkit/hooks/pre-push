#!/bin/bash
# Blocks a push if any commit or tag being pushed contains something rkit/check_clean.py flags:
# identities, home or temp paths, keys, usage data, or files it can't read. Set up by the research kit:
#   git config core.hooksPath rkit/hooks
# It checks every pushed commit, not just the latest tree, so a leak added and later removed still blocks.
# For a new branch it excludes only commits the destination actually has (asked with git ls-remote on the
# URL being pushed to), never local remote-tracking refs, which can be stale or belong to another remote.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
check="$root/rkit/check_clean.py"
url="${2:-${1:-}}"
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-push: uv isn't installed, so the leak check can't run; the push is blocked." >&2
  exit 1
fi
zero="0000000000000000000000000000000000000000"

# Commits the destination already has, as far as this repo knows them.
known=""
if remote_refs="$(git ls-remote "$url" 2>/dev/null)"; then
  for sha in $(printf '%s\n' "$remote_refs" | awk '{print $1}' | sort -u); do
    git cat-file -e "$sha^{commit}" 2>/dev/null && known="$known $sha"
  done
else
  echo "pre-push: couldn't list the destination's refs; checking the full history of what's pushed." >&2
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a remote branch
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  elif [ -n "$known" ]; then
    range="$local_sha --not$known"
  else
    range="$local_sha"
  fi
  case "$local_ref" in
    # The bare object makes check_clean read an annotated tag's message. It goes first: rev-list negates
    # everything after --not.
    refs/tags/*) range="$local_sha $range" ;;
  esac
  echo "pre-push: leak check on $local_ref" >&2
  uv run --quiet --script "$check" --root "$root" --range "$range" >&2 || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: blocked. Fix the content, or add a file-and-pattern entry with a reason to .rkit-clean.json." >&2
fi
exit "$status"
